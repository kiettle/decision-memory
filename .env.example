# Optional one-time import values. After first startup, edit integrations in the
# Settings tab; later environment changes do not overwrite the database.
# Slack credentials for the single demo workspace.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=

# Optional: Gemini AI search and Slack capture drafting. Synthetic/sanitized data only.
# Local Search by memory, Ask and "Already decided?" need no Gemini key.
GEMINI_API_KEY=

# Optional: Create Jira issue from a Decision (Jira Cloud site, account email,
# and an API token from id.atlassian.com/manage-profile/security/api-tokens).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
